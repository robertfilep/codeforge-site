# -------------------------------------------------------
# CodeForge Studio Redirect Rules
# Updated: 2025-11-03
# Purpose: Ensure React routes, SEO-friendly redirects,
#          and complete removal of old WordPress URLs.
# -------------------------------------------------------

# 🚫 Old WordPress URLs (mark as permanently gone)
# 410 = "Gone forever" → Google removes them from index
/wp-login          /404.html 410
/wp-admin          /404.html 410
/wp-json*          /404.html 410
/wp-includes/*     /404.html 410
/wp-content/*      /404.html 410

# 🚫 Old taxonomy pages (also permanently gone)
/category/*        /404.html 410
/tag/*             /404.html 410

# 🗺️ Old sitemaps → redirect to new sitemap
/wp-sitemap.xml        /sitemap.xml 301
/sitemap_index.xml     /sitemap.xml 301

# 🔐 DEV PREVIEW — START
# Private developer access (login at /dev-preview). The session cookie is
# verified server-side by netlify/edge-functions/dev-preview before these
# rules run; only verified sessions reach the real React app. To remove the
# private login, delete this block and that edge function folder.
/                  /index.html 200!  Cookie=cfs_dev_session
/*                 /index.html 200   Cookie=cfs_dev_session
# 🔐 DEV PREVIEW — END

# 🚧 MAINTENANCE MODE — START
# Serves public/maintenance.html for the homepage and every app route
# while the site is being rebuilt. Static files (images, favicon, etc.)
# are still served normally. To restore the full website, delete this
# block (from START to END). Nothing else needs to change.
/                  /maintenance.html 200!
/index.html        /maintenance.html 200!
/*                 /maintenance.html 200
# 🚧 MAINTENANCE MODE — END

# ✅ React Router fallback, including the in-app 404 page
/*                    /index.html 200
